# Public site URL (sitemap / OG)
NEXT_PUBLIC_SITE_URL=https://amanueltd.com.et

# Neon Postgres connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Admin login password (choose a strong password)
ADMIN_PASSWORD=change-me

# Random secret for signing admin session cookies (min 16 chars)
SESSION_SECRET=replace-with-a-long-random-string

# Formspree — contact form email delivery (no domain DNS required)
# Create a form at https://formspree.io and paste the form id (e.g. xyzabcde)
# or the full endpoint URL https://formspree.io/f/xyzabcde
FORMSPREE_FORM_ID=your_form_id
